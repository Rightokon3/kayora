{
  "expo": {
    "name": "kayora",
    "slug": "kayora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/kayora-logo.png",
    "scheme": "kayora",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/kayora-logo.png",
        "backgroundImage": "./assets/images/kayora-logo.png",
        "monochromeImage": "./assets/images/kayora-logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kayora.admin"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/kayora-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/kayora-logo.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "@maplibre/maplibre-react-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "968ff355-b29d-4017-8087-9603872b903e"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/968ff355-b29d-4017-8087-9603872b903e"
    }
  }
}
